# 資料庫（SQLite）
DATABASE_URL="file:./dev.db"

# ---- LLM 設定 ----
# mock = 內建擬真腳本引擎（零成本、離線可用；Playwright 測試固定使用此模式）
# real = 任何 OpenAI 相容端點
LLM_PROVIDER=mock

# 範例 A：OpenCode Go 訂閱（可搭配任何 agent；需帶專屬 User-Agent + x-opencode-session）
# LLM_PROVIDER=real
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_API_KEY=sk-你的key
# LLM_MODEL=deepseek-v4.1-flash

# 範例 B：DeepSeek 官方
# LLM_PROVIDER=real
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-你的key
# LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# ---- Jev 決策層（TypeSafe System One：Noul/Choice/Score）----
# auto：有 key 用 Jev，逾時/錯誤/無 key 自動退回本機規則
DECISION_PROVIDER=auto
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_TIMEOUT_MS=6000
